{
  "contract": "ozon-pod/agw-service-api",
  "version": 1,
  "base_path": "/api/service",
  "auth": {
    "header": "Authorization",
    "scheme": "Bearer",
    "token_config": "service.token",
    "token_env": "SERVICE_TOKEN"
  },
  "envelope": {
    "success": {
      "code": 0,
      "message": "ok"
    },
    "error": {
      "code": "int",
      "message": "string"
    }
  },
  "errors": {
    "unauthorized": {
      "http": 401,
      "code": 1001
    },
    "bad_request": {
      "http": 400,
      "code": 4000
    },
    "not_found": {
      "http": 404,
      "code": 4004
    },
    "conflict": {
      "http": 409,
      "code": 4009
    },
    "internal": {
      "http": 500,
      "code": 5000
    }
  },
  "endpoints": {
    "provision_user": {
      "method": "POST",
      "path": "/api/service/users",
      "request": {
        "email": "owner+ws1@example.com",
        "display_name": "Workspace 1"
      },
      "response": {
        "user_id": 42,
        "email": "owner+ws1@example.com",
        "created": true,
        "status": "active"
      }
    },
    "rotate_key": {
      "method": "POST",
      "path": "/api/service/users/{user_id}/keys",
      "request": {
        "name": "ozon-pod:workspace:1"
      },
      "response": {
        "key_id": 9,
        "key": "agw-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "key_prefix": "agw-0123456789ab",
        "name": "ozon-pod:workspace:1",
        "rotated": true
      }
    },
    "balance": {
      "method": "GET",
      "path": "/api/service/users/{user_id}/balance",
      "response": {
        "balance": "0.00000000",
        "currency": "USD"
      }
    },
    "usage": {
      "method": "GET",
      "path": "/api/service/users/{user_id}/usage",
      "query": [
        "start",
        "end",
        "page",
        "page_size"
      ],
      "response": {
        "page": 1,
        "page_size": 50,
        "total": 1,
        "rows": [
          {
            "id": 100,
            "request_id": "req-1",
            "idempotency_key": "ozon:req-1",
            "model": "gpt-4o",
            "provider": "openai",
            "tokens_in": 120,
            "tokens_out": 30,
            "tokens": 150,
            "cost": "0.00015000",
            "actual_cost": "0.00015000",
            "failed": false,
            "duration_ms": 812,
            "created_at": "2026-09-11T10:00:00Z",
            "currency": "USD"
          }
        ]
      }
    },
    "usage_by_idempotency_key": {
      "method": "GET",
      "path": "/api/service/users/{user_id}/usage/by-idempotency-key/{key}",
      "response": {
        "found": true,
        "row": {
          "id": 100,
          "request_id": "req-1",
          "idempotency_key": "ozon:req-1",
          "model": "gpt-4o",
          "provider": "openai",
          "tokens_in": 120,
          "tokens_out": 30,
          "tokens": 150,
          "cost": "0.00015000",
          "actual_cost": "0.00015000",
          "failed": false,
          "duration_ms": 812,
          "created_at": "2026-09-11T10:00:00Z",
          "currency": "USD"
        }
      }
    },
    "credit": {
      "method": "POST",
      "path": "/api/service/users/{user_id}/credits",
      "request": {
        "amount": "10.00000000",
        "idempotency_key": "ozon-order:PO-1",
        "note": "recharge"
      },
      "response": {
        "applied": true,
        "duplicate": false,
        "balance": "22.34000000"
      }
    },
    "models": {
      "method": "GET",
      "path": "/api/service/models",
      "response": {
        "models": [
          {
            "id": "gpt-4o",
            "owned_by": "openai"
          }
        ]
      }
    }
  }
}
