{
  "name": "dsh-agw-oauth",
  "description": "DeepSeek Harness plugin: OAuth into AI-GateWay and use models without a model config file",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.prepare.json",
    "prepare": "node ./scripts/prepare.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "ai-gateway", "oauth"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
